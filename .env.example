# ==========================================
# Vitrine - Environment Variables Configuration
# ==========================================

# Server & Application Environment
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# AI Service (Google Gemini)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Primary Database (PostgreSQL 16 System of Record with Row-Level Security)
# Format: postgres://username:password@host:port/database?sslmode=prefer
DATABASE_URL="postgresql://vitrine_app:change_me@localhost:5432/vitrine_db"
DATABASE_SSL="false"
DATABASE_POOL_MIN="2"
DATABASE_POOL_MAX="10"

# Background Jobs & Retry Queue (Redis / BullMQ)
REDIS_URL="redis://localhost:6379"

# S3-Compatible Object Storage for Merchant Product Media & Receipts
S3_ENDPOINT="https://s3.eu-west-1.amazonaws.com"
S3_REGION="eu-west-1"
S3_BUCKET="vitrine-media"
S3_ACCESS_KEY_ID="change_me"
S3_SECRET_ACCESS_KEY="change_me"
S3_PUBLIC_BASE_URL="https://vitrine-media.s3.eu-west-1.amazonaws.com"

# WhatsApp Cloud API / BSP Integration
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_WEBHOOK_APP_SECRET=""

# Payment Verification & Webhooks (Multicaixa Express / GPO / Peer-to-Peer Express)
PAYMENT_WEBHOOK_SECRET="change_me"

# Security & Sessions
SESSION_SECRET="change_me_to_a_random_32_byte_string"
