# ==========================================
# Vitrine - Environment Variables Configuration
# ==========================================

# Server & Application Environment
# Application treats any value other than "development" as production.
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# AI Service (Google Gemini - Server-side only; never exposed to client bundle)
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"

# Primary Database (PostgreSQL 16 System of Record with Row-Level Security)
# Runtime role for merchant-authenticated operations (vitrine_app)
DATABASE_URL="postgresql://vitrine_app:REPLACE_WITH_APP_PASSWORD@localhost:5432/vitrine_db"
# Public storefront view role (vitrine_public)
DATABASE_PUBLIC_URL="postgresql://vitrine_public:REPLACE_WITH_PUBLIC_PASSWORD@localhost:5432/vitrine_db"
# Merchant registration role (vitrine_registration)
DATABASE_REGISTRATION_URL="postgresql://vitrine_registration:REPLACE_WITH_REGISTRATION_PASSWORD@localhost:5432/vitrine_db"
# Platform admin operations role (vitrine_admin)
DATABASE_ADMIN_URL="postgresql://vitrine_admin:REPLACE_WITH_ADMIN_PASSWORD@localhost:5432/vitrine_db"
# Migration runner role (MUST NOT be named vitrine_*)
DATABASE_MIGRATOR_URL="postgresql://migrator:REPLACE_WITH_MIGRATOR_PASSWORD@localhost:5432/vitrine_db"
# Optional DDL timeouts for 0002+ migrations (0001_DB_v7.sql defaults both to 0 / off):
# MIGRATION_LOCK_TIMEOUT="10s"
# MIGRATION_STATEMENT_TIMEOUT="60s"

DATABASE_SSL="false"
DATABASE_POOL_MIN="2"
DATABASE_POOL_MAX="10"

# Signed Tenant Context Secret (32+ bytes hex, e.g. `openssl rand -hex 32`)
# Provisioned into vitrine_internal.app_tenant_secret slot 1 by db/operator/0001_post_migration.sql
TENANT_CONTEXT_SECRET="REPLACE_WITH_64_HEX_CHAR_TENANT_CONTEXT_SECRET"

# Background Jobs & Retry Queue (Redis / BullMQ)
REDIS_URL="redis://localhost:6379"

# S3-Compatible Object Storage for Merchant Product Media & Receipts
S3_ENDPOINT="https://s3.eu-west-1.amazonaws.com"
S3_REGION="eu-west-1"
S3_BUCKET="vitrine-media"
S3_ACCESS_KEY_ID="REPLACE_WITH_S3_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="REPLACE_WITH_S3_SECRET_KEY"
S3_PUBLIC_BASE_URL="https://vitrine-media.s3.eu-west-1.amazonaws.com"

# WhatsApp Cloud API / BSP Integration
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_WEBHOOK_APP_SECRET=""

# Payment Verification & Webhooks (Multicaixa Express / GPO / Peer-to-Peer Express)
PAYMENT_WEBHOOK_SECRET="REPLACE_WITH_PAYMENT_WEBHOOK_SECRET"

# Security & Sessions
SESSION_SECRET="REPLACE_WITH_RANDOM_32_BYTE_SESSION_SECRET"
